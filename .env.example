# ============================================================
# 工 e 稳袋 (gong-e-wendai) — 环境变量样例
# 复制为 .env（开发）或 .env.production（生产）后填写。
# 严禁把 .env / .env.production 提交到 Git。
# ============================================================

# ---------- 应用 ----------
APP_ENV=development
APP_NAME=gong-e-wendai
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------- 数据库 ----------
# 开发（相对项目 data/ 目录）
DATABASE_URL=sqlite:///./data/app.db
# 生产（绝对路径，4 个斜杠）
# DATABASE_URL=sqlite:////home/ubuntu/apps/gong-e-wendai-data/app.db

SQLITE_BUSY_TIMEOUT_MS=5000

# ---------- JWT ----------
# 生产环境务必重新生成：openssl rand -hex 32
JWT_SECRET=dev-only-change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------- CORS ----------
# 逗号分隔。生产同源部署时留空即可。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- 前端（仅构建期使用）----------
VITE_API_BASE_URL=/api/v1

# ---------- AI Provider（OpenAI 兼容接口）----------
# 关闭或未配置 Key 时，全部 AI 能力自动降级，核心功能不受影响。
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
