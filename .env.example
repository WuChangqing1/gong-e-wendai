# ============================================================
# 工 e 稳袋 (gong-e-wendai) — 环境变量样例
# 复制为 .env（开发）或 .env.production（生产）后填写。
# 严禁把 .env / .env.production 提交到 Git。
# ============================================================

# ---------- 应用 ----------
APP_ENV=development
APP_NAME=gong-e-wendai
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------- 数据库 ----------
# 开发（相对项目 data/ 目录）
DATABASE_URL=sqlite:///./data/app.db
# 生产（绝对路径，4 个斜杠）
# DATABASE_URL=sqlite:////home/ubuntu/apps/gong-e-wendai-data/app.db

SQLITE_BUSY_TIMEOUT_MS=5000

# ---------- JWT ----------
# 生产环境务必重新生成：openssl rand -hex 32
JWT_SECRET=dev-only-change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------- CORS ----------
# 逗号分隔。生产同源部署时留空即可。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- 前端（仅构建期使用）----------
VITE_API_BASE_URL=/api/v1

# ---------- 智能服务（智谱 GLM）----------
# 关闭或未配置 Key 时，全部智能能力自动降级为「智能服务暂时不可用，
# 你仍可以手动完成当前操作」，核心功能不受影响。
#
# GLM 是最高敏感信息：
#   * 只允许出现在本机进程内存、服务器 .env.production（chmod 600）
#     以及发往智谱官方接口的 Authorization 头
#   * 绝不提交到 Git，绝不写入日志、截图或 API 响应
#   * 真实值请通过服务器上的安全更新脚本以 stdin 方式写入，不要走命令行参数
AI_ENABLED=false
GLM=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_TEXT_MODEL=glm-4.5-air
GLM_VISION_MODEL=glm-4.6v
GLM_TIMEOUT_SECONDS=30
GLM_VISION_TIMEOUT_SECONDS=45
GLM_MAX_TOKENS=1024
GLM_MAX_RETRIES=2

# 兼容旧配置项（GLM_* 优先）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
